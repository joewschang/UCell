FROM ucellprodacrm3z2zx4ohqyui.azurecr.io/ucell-admin@sha256:1332dc40a64af40715fcb2996f1a36c150ff500d4c1363df92286af386629852 AS original
FROM node:22-alpine AS build
COPY --from=original /usr/share/nginx/html /usr/share/nginx/html
