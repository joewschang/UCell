FROM ucellprodacrm3z2zx4ohqyui.azurecr.io/ucell-admin@sha256:75aa72b32febb913b5a3787dc1442c2a4ed6e4e2f06384978a9a8b115e91dc09 AS original
FROM node:22-alpine AS patch
COPY --from=original /usr/share/nginx/html /site
COPY patch.cjs /patch.cjs
RUN node /patch.cjs admin /site
FROM original
COPY --from=patch /site/ /usr/share/nginx/html/
COPY admin/ /usr/share/nginx/html/health/journey/
COPY theme.css /usr/share/nginx/html/health/journey/theme.css

COPY member/qr.js member/qrcode-LICENSE.txt /usr/share/nginx/html/health/journey/
