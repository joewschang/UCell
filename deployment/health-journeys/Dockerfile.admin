FROM ucellprodacrm3z2zx4ohqyui.azurecr.io/ucell-admin@sha256:1a53f3aa463817111e05f0de9dba5285de7c99f486c15dd3a6a14a91841f009a AS original
FROM node:22-alpine AS patch
COPY --from=original /usr/share/nginx/html /site
COPY --from=original /etc/nginx/conf.d/default.conf /default.conf
COPY patch.cjs admin-inline.cjs /
COPY admin/ /site/health/journey/
RUN node /patch.cjs admin /site
FROM original
COPY --from=patch /site/ /usr/share/nginx/html/
COPY --from=patch /default.conf /etc/nginx/conf.d/default.conf
