FROM ucellprodacrm3z2zx4ohqyui.azurecr.io/ucell-member@sha256:dc01e554f232239f02886882d7a559303593c46f15ffb973d003971581291a0a
COPY cognition/site/ /usr/share/nginx/html/health/cognition/
COPY member/invite/cognition/ /usr/share/nginx/html/health/journey/invite/cognition/
COPY member/session.js member/hub.js /usr/share/nginx/html/health/journey/
RUN grep -q "path.startsWith('/health/blood-pressure/')" /usr/share/nginx/html/topics/entry.js && sed -i "s@path.startsWith('/health/blood-pressure/')?'blood-pressure'@path.startsWith('/health/cognition/')?'cognition':path.startsWith('/health/blood-pressure/')?'blood-pressure'@" /usr/share/nginx/html/topics/entry.js
