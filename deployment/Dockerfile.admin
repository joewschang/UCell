FROM node:24-alpine AS build
RUN corepack enable && corepack prepare pnpm@12.4.1 --activate
WORKDIR /app
COPY admin/package.json admin/pnpm-workspace.yaml admin/pnpm-lock.yaml* ./
COPY shared /shared
RUN test -f pnpm-lock.yaml || (echo 'pnpm-lock.yaml is mandatory for production build' && exit 1)
RUN pnpm install --frozen-lockfile
COPY admin/ ./
ARG VITE_API_BASE_URL
ARG VITE_ENTRA_TENANT_ID
ARG VITE_ENTRA_CLIENT_ID
ARG VITE_ENTRA_REDIRECT_URI
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_ENTRA_TENANT_ID=$VITE_ENTRA_TENANT_ID \
    VITE_ENTRA_CLIENT_ID=$VITE_ENTRA_CLIENT_ID \
    VITE_ENTRA_REDIRECT_URI=$VITE_ENTRA_REDIRECT_URI \
    VITE_ENABLE_DEMO_LOGIN=false
RUN pnpm build

FROM nginx:1.27-alpine
ARG CSP_API_ORIGIN
COPY deployment/nginx.admin.conf /etc/nginx/conf.d/default.conf
RUN test -n "$CSP_API_ORIGIN" && sed -i "s|__API_ORIGIN__|${CSP_API_ORIGIN}|g" /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
