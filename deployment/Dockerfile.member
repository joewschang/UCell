FROM node:24-alpine AS build
RUN corepack enable && corepack prepare pnpm@12.4.1 --activate
WORKDIR /app
COPY member/package.json member/pnpm-workspace.yaml member/pnpm-lock.yaml* ./
COPY shared /shared
RUN test -f pnpm-lock.yaml || (echo 'pnpm-lock.yaml is mandatory for Stage build' && exit 1)
RUN pnpm install --frozen-lockfile
COPY member/ ./
ARG VITE_API_BASE_URL
ARG VITE_LIFF_ID
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_LIFF_ID=$VITE_LIFF_ID \
    VITE_ENABLE_MOCK=false
RUN pnpm build

FROM nginx:1.27-alpine
COPY deployment/nginx.admin.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
