FROM ucellprodacrm3z2zx4ohqyui.azurecr.io/ucell-admin@sha256:977aab1c440311bd64be37016f4e8ade59935b468882f86fb317a168e6c82163 AS original
FROM node:22-alpine AS patch
COPY --from=original /usr/share/nginx/html /site
COPY patch.cjs /patch.cjs
RUN node /patch.cjs admin /site
FROM original
COPY --from=patch /site/ /usr/share/nginx/html/
