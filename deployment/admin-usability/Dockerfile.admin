FROM ucellprodacrm3z2zx4ohqyui.azurecr.io/ucell-admin@sha256:593e260c3ebdea0f11fce2e79eae84aee90c9c5a24cd0ab1c5baa61d268d9781 AS original
FROM node:22-alpine AS patch
COPY --from=original /usr/share/nginx/html /site
COPY patch.cjs admin.css ball-field.js topics-theme.js topics-dark.css /patch/
RUN node /patch/patch.cjs /site
FROM original
COPY --from=patch /site/ /usr/share/nginx/html/
