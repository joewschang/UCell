+import {useEffect,useRef,useState} from 'react';
+import './assistant.css';
+export type AiRequest=<T>(path:string,init?:RequestInit)=>Promise<T>;
+type Answer={status:'AVAILABLE'|'UNAVAILABLE'|'CLARIFY'|'DENIED';title:string;text:string;facts:{label:string;value:string;unit?:string}[];columns?:string[];rows?:string[][];sources:{label:string;ref:string}[];definitionVersion:string;period?:{start:string;end:string};updatedAt:string;notice?:string;exportable?:boolean};
+type Turn={turnId:string;status:string;answer?:Answer;snapshotId?:string;code?:string;requestId?:string};
+const errorText=(e:any)=>{const c=e?.code??e?.body?.code;return ({AI_CAPABILITY_REQUIRED:'此帳號尚未加入 AI Stage 測試名單，請由管理者授權。',AI_MODEL_NOT_CONFIGURED:'模型服務尚未設定，請稍後再試。',AI_QUOTA_EXCEEDED:'已達測試用量上限，請稍後再試。',AI_CONTEXT_CHANGED:'資格範圍已變更，請重新查詢。',AI_VERIFIED_SESSION_REQUIRED:'AI 功能需要有效登入，不能使用略過驗證的管理員示範模式。'} as Record<string,string>)[c]??e?.message??'查詢暫時無法完成，請稍後再試。';};
+const friendly=(code?:string)=>({AI_PROVIDER_QUOTA:'模型服務忙碌或配額已滿，請稍後重試。',AI_PROVIDER_UNAVAILABLE:'模型服務暫時無法連線。',AI_WORK_INTERRUPTED:'查詢中斷，請重新提出問題。',AI_MODEL_NOT_CONFIGURED:'模型服務尚未設定。',AI_PERIOD_INVALID:'查詢日期不正確，請指定一年內的有效期間。',AI_SESSION_REVOKED:'登入已失效，請重新登入。'} as Record<string,string>)[code??'']??'查詢服務暫時無法取得完整資料，請稍後重試。';
+export function Assistant({audience,qualificationId,qualificationLabel,request,download}:{audience:'admin'|'member';qualificationId?:string;qualificationLabel?:string;request:AiRequest;download?:(id:string)=>Promise<void>}){
+ const [question,setQuestion]=useState(''),[asked,setAsked]=useState(''),[result,setResult]=useState<Turn|null>(null),[busy,setBusy]=useState(false),[error,setError]=useState(''),[info,setInfo]=useState<any>(),[notice,setNotice]=useState('');
+ const run=useRef(0),abort=useRef<AbortController|null>(null),turn=useRef<string|null>(null);const base='/'+audience+'/ai';
+ useEffect(()=>{const c=new AbortController();void request<any>(base+'/capabilities',{signal:c.signal}).then(setInfo).catch(e=>{if(!c.signal.aborted)setError(errorText(e))});return()=>c.abort()},[base,request]);
+ useEffect(()=>{run.current++;abort.current?.abort();setResult(null);setAsked('');setBusy(false);setQuestion('');if(turn.current)void request(base+'/turns/'+turn.current+'/cancel',{method:'POST',body:'{}'}).catch(()=>{});turn.current=null;return()=>{run.current++;abort.current?.abort();if(turn.current)void request(base+'/turns/'+turn.current+'/cancel',{method:'POST',body:'{}'}).catch(()=>{});}},[qualificationId,base,request]);
+ async function ask(text:string){if(!text.trim()||busy||!info)return;const gen=++run.current,c=new AbortController();abort.current=c;setBusy(true);setError('');setNotice('');setResult(null);setAsked(text);setQuestion('');
+  try{const conversation=await request<any>(base+'/conversations',{method:'POST',signal:c.signal,body:JSON.stringify({qualificationId:qualificationId??null})});const queued=await request<any>(base+'/conversations/'+conversation.id+'/turns',{method:'POST',signal:c.signal,headers:{'Idempotency-Key':crypto.randomUUID()},body:JSON.stringify({message:text,contextVersion:conversation.contextVersion})});turn.current=queued.turnId;
+   for(let n=0;n<32;n++){if(gen!==run.current)return;const answer=await request<Turn>(base+'/turns/'+queued.turnId,{signal:c.signal});if(gen!==run.current)return;if(!['QUEUED','RUNNING'].includes(answer.status)){setResult(answer);if(answer.status==='FAILED')setError(friendly(answer.code));return;}await new Promise<void>((resolve,reject)=>{const timer=setTimeout(()=>{c.signal.removeEventListener('abort',stop);resolve()},900);function stop(){clearTimeout(timer);reject(new Error('cancelled'))}c.signal.addEventListener('abort',stop,{once:true})});}throw new Error('查詢尚未完成，請稍後重試。');
+  }catch(e){if(gen===run.current&&!c.signal.aborted)setError(errorText(e));}finally{if(gen===run.current){setBusy(false);turn.current=null;}}
+ }
+ function cancel(){run.current++;abort.current?.abort();if(turn.current)void request(base+'/turns/'+turn.current+'/cancel',{method:'POST',body:'{}'}).catch(()=>{});turn.current=null;setBusy(false);setNotice('已停止查詢。');}
+ async function exportReport(){try{const job=await request<any>(base+'/report-jobs',{method:'POST',body:JSON.stringify({snapshotId:result?.snapshotId})});await download?.(job.id);setNotice('已下載目前快照的 CSV 報表。')}catch(e){setError(errorText(e))}}
