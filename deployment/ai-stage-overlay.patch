l>新版本不會覆寫舊版；必須由另一位有權審核者核准。</small></form></section>}
+export function AiAuditPage(){const [rows,setRows]=useState<any[]>([]),[error,setError]=useState('');useEffect(()=>{void api<any[]>('/admin/ai/audit').then(setRows).catch(e=>setError(e.message))},[]);return <section className="uc-ai"><div className="uc-ai-hero"><div><small>UCELL AI · GOVERNANCE</small><h1>AI 治理與稽核</h1><p>只顯示執行中繼資料，不保存問題原文或秘密。</p></div></div>{error&&<p role="alert">{error}</p>}<div className="uc-ai-panel uc-ai-table"><table><thead><tr><th>時間 台北</th><th>對象</th><th>動作</th><th>結果</th><th>詳情</th></tr></thead><tbody>{rows.map(r=><tr key={r.id}><td>{new Date(r.created_at).toLocaleString('zh-TW',{timeZone:'Asia/Taipei'})}</td><td>{r.audience}</td><td>{r.action}</td><td>{r.outcome}</td><td><details><summary>追蹤資料</summary><pre>{JSON.stringify(r.details,null,2)}</pre></details></td></tr>)}</tbody></table></div></section>}
