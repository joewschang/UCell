+export function AiKnowledgePage(){const [rows,setRows]=useState<any[]>([]),[error,setError]=useState(''),[busy,setBusy]=useState(false),[notice,setNotice]=useState('');async function refresh(){try{setRows(await api<any[]>('/admin/ai/knowledge'))}catch(e:any){setError(e.message)}}useEffect(()=>{void refresh()},[]);
+ async function action(row:any,name:string){setBusy(true);setError('');try{await api('/admin/ai/knowledge/'+row.id+'/'+name,{method:'POST',body:JSON.stringify({revision:row.revision})});setNotice('狀態已更新');await refresh()}catch(e:any){setError(e?.body?.code==='AI_KNOWLEDGE_WORKFLOW'?'作者不能核准自己的版本，或狀態已變更。':e?.body?.code==='AI_KNOWLEDGE_OVERLAP'?'此主題有重疊的有效版本，請先停用或調整版本。':e.message)}finally{setBusy(false)}}
+ async function create(e:React.FormEvent<HTMLFormElement>){e.preventDefault();const form=e.currentTarget,data=new FormData(form);setBusy(true);setError('');try{await api('/admin/ai/knowledge',{method:'POST',body:JSON.stringify({topic:data.get('topic'),title:data.get('title'),body:data.get('body'),audience:data.get('audience'),sourceRef:data.get('sourceRef'),effectiveFrom:new Date(String(data.get('from'))+'T00:00:00+08:00').toISOString(),effectiveTo:new Date(String(data.get('to'))+'T00:00:00+08:00').toISOString()})});form.reset();setNotice('已建立草稿，尚未發布');await refresh()}catch(e:any){setError(e.message)}finally{setBusy(false)}}
