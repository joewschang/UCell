FROM nginx:1.27-alpine
COPY deployment/nginx.website.conf /etc/nginx/conf.d/default.conf
COPY website/*.html website/robots.txt website/sitemap.xml /usr/share/nginx/html/
COPY website/assets /usr/share/nginx/html/assets
COPY website/css /usr/share/nginx/html/css
COPY website/js /usr/share/nginx/html/js
EXPOSE 80
