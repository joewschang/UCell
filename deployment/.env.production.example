NODE_ENV=production
PORT=3000
SWAGGER_ENABLED=false
ADMIN_AUTH_BYPASS=false
DATABASE_URL=postgresql://CHANGE_ME
ENTRA_TENANT_ID=CHANGE_ME
ENTRA_CLIENT_ID=CHANGE_ME
LINE_LOGIN_CHANNEL_ID=CHANGE_ME
IDENTITY_MATCH_HMAC_SECRET=CHANGE_ME_MIN_32_CHARS
KYC_STORAGE_ACCOUNT_NAME=CHANGE_ME
KYC_STORAGE_CONTAINER=formal-kyc
KYC_STORAGE_MANAGED_IDENTITY_CLIENT_ID=CHANGE_ME
GOOGLE_OIDC_CLIENT_ID=CHANGE_ME
MEMBER_SESSION_TTL_SECONDS=3600
MEMBER_WEB_PUBLIC_ORIGIN=https://app.ucell.life
# SMS OTP login is deferred until the selected supplier API is approved.
AUTH_CHANNEL_ENABLE_SMS_OTP=false
PASSWORD_RESET_EMAIL_WEBHOOK_URL=CHANGE_ME
PASSWORD_RESET_EMAIL_WEBHOOK_TOKEN=CHANGE_ME
ADMIN_SESSION_TTL_SECONDS=3600
VITE_API_BASE_URL=https://api.ucell.life/api/v1
VITE_ENABLE_DEMO_LOGIN=false
VITE_ENTRA_TENANT_ID=CHANGE_ME
VITE_ENTRA_CLIENT_ID=CHANGE_ME
VITE_ENTRA_REDIRECT_URI=https://admin.ucell.life/login
VITE_LIFF_ID=CHANGE_ME
VITE_GOOGLE_OIDC_CLIENT_ID=CHANGE_ME

# Exact origins; use the Stage origins for Stage. No paths or wildcards.
CORS_ALLOWED_ORIGINS=https://admin.ucell.life,https://app.ucell.life
CSP_API_ORIGIN=https://api.ucell.life

# Daily public greeting posters. API uses 07:00 Asia/Taipei, no member data or paid AI calls.
DAILY_GREETING_PUBLIC_API_BASE_URL=https://api.ucell.life/api/v1
# Optional override when the Noto CJK font is not installed in /usr/share/fonts:
# DAILY_GREETING_FONT_PATH=/usr/share/fonts/noto/NotoSansCJK-Regular.ttc
