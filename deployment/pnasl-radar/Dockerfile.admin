FROM ucellprodacrm3z2zx4ohqyui.azurecr.io/ucell-admin@sha256:78e9cdcd483ec7d0d290caf1683b149e736cf6756bcdfdcb21b051d517b8f3e4 AS original
FROM node:22-alpine AS build
COPY --from=original /usr/share/nginx/html /site
COPY patch.cjs /tmp/radar.cjs
RUN node /tmp/radar.cjs admin /site
FROM original
COPY --from=build /site/ /usr/share/nginx/html/
