FROM ucellprodacrm3z2zx4ohqyui.azurecr.io/ucell-admin@sha256:30a660cffb1ee981339c51daa5924ba82e96f11cbd72be3be767dc4fba7c8764 AS original
FROM node:22-alpine AS patch
WORKDIR /patch
RUN npm install --no-audit --no-fund --no-save typescript@5.8.3
COPY --from=original /usr/share/nginx/html /site
COPY patch.cjs identity.jsx page.css ./
RUN node patch.cjs /site
FROM original
COPY --from=patch /site/ /usr/share/nginx/html/
