FROM ucellprodacrm3z2zx4ohqyui.azurecr.io/ucell-admin@sha256:6980159a339a9434eeece0921fdc7dbd5428d292e33c5c0a31c3b5cab64e7cea AS original
FROM node:22-alpine AS patch
WORKDIR /patch
RUN npm install --no-audit --no-fund --no-save typescript@5.8.3
COPY --from=original /usr/share/nginx/html /site
COPY patch.cjs tree-picker.jsx greetings.jsx page.css ./
RUN node patch.cjs /site
FROM original
COPY --from=patch /site/ /usr/share/nginx/html/
