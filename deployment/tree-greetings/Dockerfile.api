RUN cd /app/apps/api/dist && printf '\nrequire("../../tree-directory.cjs").register(exports.AdminObservabilityController);\n' >> modules/admin-observability/admin-observability.controller.js && node -e "require('./modules/admin-observability/admin-observability.controller.js')"
