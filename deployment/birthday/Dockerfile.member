FROM ucellprodacrm3z2zx4ohqyui.azurecr.io/ucell-member@sha256:23c20cc31c267f63fd0b62a784ff9d118bd5ffe38ae657cb35a3626ceb37f2ab AS live
FROM node:22-alpine AS build
COPY --from=live /usr/share/nginx/html /site
COPY patch.cjs /patch.cjs
RUN node /patch.cjs /site
FROM live
COPY --from=build /site /usr/share/nginx/html
COPY entry.js date.js copy.json birthday.css chime.wav /usr/share/nginx/html/birthday/v1/
