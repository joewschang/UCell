generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "membership", "organization", "commerce", "ledger", "audit", "integration", "rules", "subscription"]
}

enum RecordStatus {
  DRAFT
  PENDING
  APPROVED
  EFFECTIVE
  SUSPENDED
  VOIDED
  CLOSED

  @@schema("membership")
}

enum SideCode {
  LEFT
  RIGHT

  @@schema("organization")
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PAID
  FULFILLED
  PARTIAL_RETURN
  RETURNED
  VOIDED

