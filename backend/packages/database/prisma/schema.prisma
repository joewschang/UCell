model Person {
  geoProfile MemberGeoProfile?
  geoProfileVersions MemberGeoProfileVersion[]
  qualificationOwnerIntervals QualificationOwnerInterval[]
  personId         String                 @id @default(uuid()) @map("person_id") @db.Uuid
  /// Immutable business identifier. Allocated in PostgreSQL using Asia/Taipei YYMM month counters.
  memberNo         String                 @unique @default(dbgenerated("identity.allocate_member_no()")) @map("member_no")
  legalName        String                 @map("legal_name")
  preferredName    String?                @map("preferred_name")
  birthDate        DateTime?              @map("birth_date") @db.Date
  mobile           String?
  email            String?
  genderCode       String?                @map("gender_code")
  nationalityCode  String?                @map("nationality_code")
  identityDocumentType IdentityDocumentType? @map("identity_document_type")
  identityDocumentNumberCiphertext String? @map("identity_document_number_ciphertext") @db.Text
  identityDocumentKeyVersion String?       @map("identity_document_key_version")
  identityDocumentFingerprint String?      @unique @map("identity_document_fingerprint")
  membershipState  PersonMembershipState? @map("membership_state")
  mobileVerifiedAt DateTime?              @map("mobile_verified_at") @db.Timestamptz(6)
  securityStatus   PersonSecurityStatus   @default(NORMAL) @map("security_status")
  securityLockedAt DateTime?              @map("security_locked_at") @db.Timestamptz(6)
  securityLockedReason String?            @map("security_locked_reason")
  status           RecordStatus           @default(DRAFT)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  qualifications           Qualification[]
  holderHistory            QualificationHolderHistory[]
  membershipApplications   MembershipApplication[]
  identityLinks            IdentityLink[]
  authSessions             AuthSession[]
  adminAccessGrants        AdminAccessGrant[]
  memberNotifications      MemberNotification[]
  consentEvidence          ConsentEvidence[]
  membershipStateEvents    PersonMembershipStateEvent[]
  otpChallenges            OtpChallenge[]
  deliveryProfiles         DeliveryProfile[]
  referralAttributions     ReferralAttribution[]
  referralBindingHistory   ReferralAttributionHistory[]
  formalMemberApplications FormalMemberApplication[]
  legalEntityRepresentations LegalEntityRepresentative[]
  spouseRelationships       SpouseRelationship[]
  formalIdentityIndex       FormalIdentityIndex?
  memberPasswordCredential  MemberPasswordCredential?
  passwordResetTokens       PasswordResetToken[]
  accountRecoveryRequests  AccountRecoveryRequest[]
  retailOrders             Order[]                 @relation("RetailOrderPurchaser")
  retailReferrerAttributions RetailReferrerAttribution[]
  retailReferrerCorrectionEvents RetailReferrerAttributionEvent[] @relation("RetailReferrerCorrectionActor")
  paperApplications          PaperApplication[]
  paperIdentityFingerprints  PaperPersonIdentityFingerprint[]
  learningEnrollments        LearningEnrollment[]
  eventRegistrations         MemberEventRegistration[]

  @@index([legalName])
  @@index([mobile])
  @@map("person")
  @@schema("identity")
}

model LegalEntity {
  legalEntityId         String                @id @default(uuid()) @map("legal_entity_id") @db.Uuid
  memberNo              String                @unique @default(dbgenerated("identity.allocate_member_no()")) @map("member_no")
  registeredName        String                @map("registered_name")
  registrationCountryCode String?              @map("registration_country_code")
  registrationNo        String                @unique @map("registration_no")
  registeredAddress     String?               @map("registered_address")
  membershipState       PersonMembershipState? @map("membership_state")
  status                LegalEntityStatus     @default(DRAFT)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  representatives       LegalEntityRepresentative[]
  qualifications        Qualification[]
  holderHistory         QualificationHolderHistory[]
  ownerIntervals        QualificationOwnerInterval[]
  membershipApplications MembershipApplication[]
  packagePurchases       PackagePurchaseSnapshot[]
  formalApplications    FormalMemberApplication[]

  @@index([status])
  @@map("legal_entity")
  @@schema("identity")
}

model LegalEntityRepresentative {
  legalEntityRepresentativeId String      @id @default(uuid()) @map("legal_entity_representative_id") @db.Uuid
  legalEntityId               String      @map("legal_entity_id") @db.Uuid
  personId                    String      @map("person_id") @db.Uuid
  roleCode                    String      @default("PRIMARY_OPERATING_REPRESENTATIVE") @map("role_code")
  effectiveFrom               DateTime    @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo                 DateTime?   @map("effective_to") @db.Timestamptz(6)
  verifiedAt                  DateTime?   @map("verified_at") @db.Timestamptz(6)
  verifiedBy                  String?     @map("verified_by") @db.Uuid
  createdAt                   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  legalEntity                 LegalEntity @relation(fields: [legalEntityId], references: [legalEntityId])
  person                      Person      @relation(fields: [personId], references: [personId])

  @@index([legalEntityId, effectiveFrom, effectiveTo])
  @@index([personId, effectiveFrom, effectiveTo])
  @@map("legal_entity_representative")
  @@schema("identity")
}

model SpouseRelationship {
  spouseRelationshipId        String                    @id @default(uuid()) @map("spouse_relationship_id") @db.Uuid
  personId                    String                    @map("person_id") @db.Uuid
  spouseIdentityFingerprint   String                    @map("spouse_identity_fingerprint")
  spouseNameMasked            String                    @map("spouse_name_masked")
  verificationStatus          SpouseVerificationStatus  @default(PENDING) @map("verification_status")
  effectiveFrom               DateTime                  @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo                 DateTime?                 @map("effective_to") @db.Timestamptz(6)
  verifiedAt                  DateTime?                 @map("verified_at") @db.Timestamptz(6)
  verifiedBy                  String?                   @map("verified_by") @db.Uuid
  sourceFormalApplicationId   String?                   @map("source_formal_application_id") @db.Uuid
  createdAt                   DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  person                      Person                    @relation(fields: [personId], references: [personId])
  sourceFormalApplication     FormalMemberApplication?  @relation(fields: [sourceFormalApplicationId], references: [formalMemberApplicationId])

  @@index([personId, effectiveFrom, effectiveTo])
  @@index([spouseIdentityFingerprint, verificationStatus])
  @@map("spouse_relationship")
  @@schema("identity")
}

model FormalIdentityIndex {
  formalIdentityIndexId       String                   @id @default(uuid()) @map("formal_identity_index_id") @db.Uuid
  personId                    String                   @unique @map("person_id") @db.Uuid
  identityDocumentFingerprint       String                   @unique @map("identity_document_fingerprint")
  verifiedAt                  DateTime                 @map("verified_at") @db.Timestamptz(6)
  verifiedBy                  String?                  @map("verified_by") @db.Uuid
  sourceFormalApplicationId   String                   @map("source_formal_application_id") @db.Uuid
  createdAt                   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  person                      Person                   @relation(fields: [personId], references: [personId])
  sourceFormalApplication     FormalMemberApplication  @relation(fields: [sourceFormalApplicationId], references: [formalMemberApplicationId])

  @@index([identityDocumentFingerprint])
  @@map("formal_identity_index")
  @@schema("identity")
}

model FormalMemberApplication {
  formalMemberApplicationId String                            @id @default(uuid()) @map("formal_member_application_id") @db.Uuid
  personId                  String                            @map("person_id") @db.Uuid
  applicantType             FormalApplicantType               @default(INDIVIDUAL) @map("applicant_type")
  sourceChannel             FormalApplicationSourceChannel    @default(MEMBER_WEB) @map("source_channel")
  paperApplicationReference String?                            @map("paper_application_reference")
  enteredBy                 String?                            @map("entered_by") @db.Uuid
  enteredAt                 DateTime?                          @map("entered_at") @db.Timestamptz(6)
  legalEntityId             String?                           @map("legal_entity_id") @db.Uuid
  legalEntityRegistrationNo String?                           @map("legal_entity_registration_no")
  applicantNationalityCode   String?                        @map("applicant_nationality_code")
  applicantIdentityDocumentType IdentityDocumentType?       @map("applicant_identity_document_type")
  applicantIdentityFingerprint String?                       @map("applicant_identity_fingerprint")
  spouseIdentityFingerprint String?                           @map("spouse_identity_fingerprint")
  spouseVerificationStatus  SpouseVerificationStatus          @default(NOT_APPLICABLE) @map("spouse_verification_status")
  crossLineReviewStatus     String                            @default("NOT_EVALUATED") @map("cross_line_review_status")
  crossLineConflictCode     String?                           @map("cross_line_conflict_code")
  status                    String                            @default("DRAFT")
  currentSnapshotHash       String                            @map("current_snapshot_hash")
  createdAt                 DateTime                          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                          @updatedAt @map("updated_at") @db.Timestamptz(6)
  submittedAt               DateTime?                         @map("submitted_at") @db.Timestamptz(6)
  reviewedAt                DateTime?                         @map("reviewed_at") @db.Timestamptz(6)
  reviewerId                String?                           @map("reviewer_id") @db.Uuid
  decisionReasonCode        String?                           @map("decision_reason_code")
  person                    Person                            @relation(fields: [personId], references: [personId])
  legalEntity               LegalEntity?                      @relation(fields: [legalEntityId], references: [legalEntityId])
  snapshots                 FormalMemberApplicationSnapshot[]
  spouseRelationships       SpouseRelationship[]
  identityIndexes           FormalIdentityIndex[]
  documents                 FormalApplicationDocument[]
  paperEvidence             FormalPaperEvidence[]

  @@index([personId, status])
  @@index([legalEntityId, status])
  @@index([applicantType, sourceChannel, status])
  @@index([legalEntityRegistrationNo])
  @@index([spouseIdentityFingerprint])
  @@index([applicantIdentityFingerprint])
  @@map("formal_member_application")
  @@schema("identity")
}

model FormalApplicationDocument {
  formalApplicationDocumentId String                  @id @default(uuid()) @map("formal_application_document_id") @db.Uuid
  formalMemberApplicationId   String                  @map("formal_member_application_id") @db.Uuid
  documentType                FormalDocumentType      @map("document_type")
  status                      FormalDocumentStatus    @default(PENDING_UPLOAD)
  storageObjectKey            String?                 @map("storage_object_key")
  contentSha256               String?                 @map("content_sha256")
  mimeType                    String?                 @map("mime_type")
  sizeBytes                   Int?                    @map("size_bytes")
  malwareScanStatus           MalwareScanStatus       @default(PENDING) @map("malware_scan_status")
  uploadedByPersonId          String?                 @map("uploaded_by_person_id") @db.Uuid
  uploadedAt                  DateTime?               @map("uploaded_at") @db.Timestamptz(6)
  reviewedBy                  String?                 @map("reviewed_by") @db.Uuid
  reviewedAt                  DateTime?               @map("reviewed_at") @db.Timestamptz(6)
  createdAt                   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  application                 FormalMemberApplication @relation(fields: [formalMemberApplicationId], references: [formalMemberApplicationId])

  @@index([formalMemberApplicationId, documentType])
  @@index([malwareScanStatus, status])
  @@map("formal_application_document")
  @@schema("identity")
}

model FormalPaperEvidence {
  formalPaperEvidenceId      String                  @id @default(uuid()) @map("formal_paper_evidence_id") @db.Uuid
  formalMemberApplicationId  String                  @map("formal_member_application_id") @db.Uuid
  evidenceType               FormalDocumentType      @map("evidence_type")
  status                     PaperEvidenceStatus     @default(PENDING)
  sourceReference            String?                 @map("source_reference")
  reviewedBy                 String?                 @map("reviewed_by") @db.Uuid
  reviewedAt                 DateTime?               @map("reviewed_at") @db.Timestamptz(6)
  note                       String?
  createdAt                  DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  application                FormalMemberApplication @relation(fields: [formalMemberApplicationId], references: [formalMemberApplicationId])

  @@unique([formalMemberApplicationId, evidenceType])
  @@index([formalMemberApplicationId, status])
  @@map("formal_paper_evidence")
  @@schema("identity")
}

model FormalMemberApplicationSnapshot {
  geoProfiles MemberGeoProfile[]
  geoProfileVersions MemberGeoProfileVersion[]
  formalMemberApplicationSnapshotId String                  @id @default(uuid()) @map("formal_member_application_snapshot_id") @db.Uuid
  formalMemberApplicationId         String                  @map("formal_member_application_id") @db.Uuid
  version                           Int
  payloadCiphertext                 String                  @map("payload_ciphertext") @db.Text
  keyVersion                        String                  @map("key_version")
  payloadHash                       String                  @map("payload_hash")
  createdAt                         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  application                       FormalMemberApplication @relation(fields: [formalMemberApplicationId], references: [formalMemberApplicationId])

  @@unique([formalMemberApplicationId, version])
  @@index([payloadHash])
  @@map("formal_member_application_snapshot")
  @@schema("identity")
}

model GeoAdminArea {
  areaCode String @id @map("area_code")
  countryCode String @map("country_code")
  level String
  parentAreaCode String? @map("parent_area_code")
  areaNameZh String @map("area_name_zh")
  areaNameEn String? @map("area_name_en")
  regionGroup String @map("region_group")
  sortOrder Int @map("sort_order")
