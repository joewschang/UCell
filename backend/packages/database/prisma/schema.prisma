generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "membership", "organization", "commerce", "ledger", "audit", "integration", "rules", "subscription"]
}

enum RecordStatus {
  DRAFT
  PENDING
  APPROVED
  EFFECTIVE
  SUSPENDED
  VOIDED
  CLOSED

  @@schema("membership")
}

enum SideCode {
  LEFT
  RIGHT

  @@schema("organization")
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PAID
  FULFILLED
  PARTIAL_RETURN
  RETURNED
  VOIDED

  @@schema("commerce")
}

enum PvType {
  GPV
  PV
  RPV
  EPV
  GLOBAL

  @@schema("ledger")
}

enum EventProcessStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD

  @@schema("integration")
}


enum ApplicationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  EFFECTIVE
  VOIDED

  @@schema("membership")
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
  COMPLETED

  @@schema("subscription")
}

enum RecognitionStatus {
  SCHEDULED
  DUE
  RECOGNIZED
  CANCELLED
  REVERSED

  @@schema("subscription")
}


enum BonusAwardType {
  REFERRAL
  EQUALIZATION
  BINARY
  MATCHING
  RPV
  EPV
  GLOBAL

  @@schema("ledger")
}

enum BonusAwardLifecycleStatus {
  CALCULATED
  PENDING_45D
  EFFECTIVE
  PAYABLE
  PAID
  REVERSED
  CLAWBACK

  @@schema("ledger")
}

enum SettlementType {
  REFERRAL_K0
  BINARY_K1
  MATCHING_K2

  @@schema("ledger")
}

enum SettlementStatus {
  DRAFT
  CALCULATED
  FINALIZED
  VOIDED

  @@schema("ledger")
}


enum QualificationLifecycleStatus {
  DRAFT
  PENDING
  EFFECTIVE
  SUSPENDED
  EXITED
  TRANSFERRED
  VOIDED
  CLOSED

  @@schema("membership")
}

enum OrderPurpose {
  ENTRY
  RETAIL
  REPURCHASE
  SUBSCRIPTION_PREPAY
  UPGRADE

  @@schema("commerce")
}

enum ReturnStatus {
  DRAFT
  CONFIRMED
  POSTED
  VOIDED

  @@schema("commerce")
}

enum RecoveryStatus {
  OPEN
  OFFSETTING
  RECOVERED
  WAIVED

  @@schema("ledger")
}

enum PayoutBatchStatus {
  DRAFT
  READY
  EXPORTED
  PAID
  VOIDED

  @@schema("ledger")
}

enum GlobalRankCode {
  NEW_STAR
  EXCELLENCE
  GLORY
  DIAMOND
  CROWN

  @@schema("ledger")
}


enum AdjustmentStatus {
  DRAFT
  CALCULATED
  POSTED
  VOIDED
  @@schema("ledger")
}

enum QualificationWorkflowType {
  UPGRADE
  TRANSFER
  EXIT
  COMPANY_RETRANSFER
  @@schema("membership")
}

enum QualificationWorkflowStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  EFFECTIVE
  CANCELLED
  @@schema("membership")
}

enum ReplayRunStatus {
  PENDING
  RUNNING
  CONVERGED
  MAX_HORIZON
  FAILED
  @@schema("ledger")
}

enum IdentityProvider {
  ADMIN_LOCAL
  ENTRA
  LINE
  GOOGLE
  @@schema("identity")
}

enum ContractAudience {
  NETWORK_MEMBER
  FORMAL_MEMBER
  ALL_MEMBERS
  @@schema("identity")
}

enum ConsentChannel {
  MEMBER_WEB
  LIFF
  ADMIN_ASSISTED
  @@schema("identity")
}

enum PersonMembershipState {
  NETWORK_MEMBER
  FORMAL_PENDING
  FORMAL_MEMBER
  @@schema("identity")
}

enum OtpPurpose {
  NETWORK_REGISTRATION
  MOBILE_CHANGE
  ACCOUNT_RECOVERY
  @@schema("identity")
}

enum OtpChallengeStatus {
  PENDING
  VERIFIED
  EXPIRED
  LOCKED
  @@schema("identity")
}

enum AuthSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
  @@schema("identity")
}

model Person {
  personId       String       @id @default(uuid()) @map("person_id") @db.Uuid
  legalName      String       @map("legal_name")
  preferredName  String?      @map("preferred_name")
  birthDate      DateTime?    @map("birth_date") @db.Date
  mobile         String?
  email          String?
  genderCode     String?      @map("gender_code")
  membershipState PersonMembershipState? @map("membership_state")
  mobileVerifiedAt DateTime?  @map("mobile_verified_at") @db.Timestamptz(6)
  status         RecordStatus @default(DRAFT)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  qualifications Qualification[]
  holderHistory  QualificationHolderHistory[]
  membershipApplications MembershipApplication[]
  identityLinks IdentityLink[]
  authSessions AuthSession[]
  adminAccessGrants AdminAccessGrant[]
  memberNotifications MemberNotification[]
  consentEvidence ConsentEvidence[]
  membershipStateEvents PersonMembershipStateEvent[]
  otpChallenges OtpChallenge[]

  @@index([legalName])
  @@index([mobile])
  @@map("person")
  @@schema("identity")
}

model OtpChallenge {
  otpChallengeId String @id @default(uuid()) @map("otp_challenge_id") @db.Uuid
  personId String? @map("person_id") @db.Uuid
  registrationSessionId String? @map("registration_session_id") @db.Uuid
  purpose OtpPurpose
  destinationFingerprint String @map("destination_fingerprint")
  codeHash String @map("code_hash")
  providerRef String @map("provider_ref")
  status OtpChallengeStatus @default(PENDING)
  attemptCount Int @default(0) @map("attempt_count")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  resendAvailableAt DateTime @map("resend_available_at") @db.Timestamptz(6)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  lockedAt DateTime? @map("locked_at") @db.Timestamptz(6)
  correlationId String @map("correlation_id") @db.Uuid
  person Person? @relation(fields:[personId],references:[personId])

  @@index([destinationFingerprint,createdAt])
  @@index([registrationSessionId,purpose,status])
  @@index([personId,purpose,status])
  @@map("otp_challenge")
  @@schema("identity")
}

model PersonMembershipStateEvent {
  personMembershipStateEventId String @id @default(uuid()) @map("person_membership_state_event_id") @db.Uuid
  personId String @map("person_id") @db.Uuid
  fromState PersonMembershipState? @map("from_state")
  toState PersonMembershipState @map("to_state")
  reasonCode String @map("reason_code")
  sourceType String @map("source_type")
  sourceId String? @map("source_id") @db.Uuid
  correlationId String @map("correlation_id") @db.Uuid
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  person Person @relation(fields:[personId],references:[personId])

  @@index([personId,occurredAt])
  @@index([correlationId])
  @@map("person_membership_state_event")
  @@schema("identity")
}

model ContractDocumentVersion {
  contractDocumentVersionId String @id @default(uuid()) @map("contract_document_version_id") @db.Uuid
  contractType String @map("contract_type")
  versionCode String @map("version_code")
  title String
  contentText String @map("content_text") @db.Text
  contentHash String @map("content_hash")
  audience ContractAudience
  required Boolean @default(true)
  effectiveFrom DateTime @map("effective_from") @db.Timestamptz(6)
  effectiveTo DateTime? @map("effective_to") @db.Timestamptz(6)
  approvalReference String @map("approval_reference")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  consentEvidence ConsentEvidence[]

  @@unique([contractType,versionCode])
  @@index([audience,effectiveFrom,effectiveTo])
  @@map("contract_document_version")
  @@schema("identity")
}

model ConsentEvidence {
  consentEvidenceId String @id @default(uuid()) @map("consent_evidence_id") @db.Uuid
  personId String @map("person_id") @db.Uuid
  contractDocumentVersionId String @map("contract_document_version_id") @db.Uuid
  contentHashSnapshot String @map("content_hash_snapshot")
  channel ConsentChannel
  acceptedAt DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)
  requestId String @map("request_id")
  correlationId String @map("correlation_id") @db.Uuid
  evidenceHash String @map("evidence_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  person Person @relation(fields:[personId],references:[personId])
  contractVersion ContractDocumentVersion @relation(fields:[contractDocumentVersionId],references:[contractDocumentVersionId])

  @@unique([personId,contractDocumentVersionId])
  @@index([contractDocumentVersionId,acceptedAt])
  @@index([correlationId])
  @@map("consent_evidence")
  @@schema("identity")
}

model Qualification {
  memberNotifications MemberNotification[]
  qualificationId       String       @id @default(uuid()) @map("qualification_id") @db.Uuid
  qualificationNo       BigInt       @unique @default(autoincrement()) @map("qualification_no")
  currentHolderPersonId String       @map("current_holder_person_id") @db.Uuid
  planLevelCode         String       @map("plan_level_code")
  status                RecordStatus @default(DRAFT)
  activeFlag            Boolean      @default(false) @map("active_flag")
  effectiveAt           DateTime?    @map("effective_at") @db.Timestamptz(6)
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  currentHolder Person @relation(fields: [currentHolderPersonId], references: [personId])
  holderHistory QualificationHolderHistory[]
  sponsoredChildren SponsorRelationship[] @relation("Sponsor")
  sponsorRelation SponsorRelationship? @relation("SponsoredChild")
  binaryChildren BinaryPlacement[] @relation("BinaryParent")
  binaryPlacement BinaryPlacement? @relation("BinaryChild")
  orders Order[]
  pvEvents PvLedger[]
  activePeriods ActivePeriod[]
  subscriptions Subscription[]
  membershipApplications MembershipApplication[]
  bonusAwards BonusAward[] @relation("BonusRecipient")
  sourceBonusAwards BonusAward[] @relation("BonusSource")
  binaryCarry BinaryCarry[]
  qualificationStatusHistory QualificationStatusHistory[]
  globalRankHistory QualificationGlobalRankHistory[]
  payoutLines PayoutLine[]
  payableEntries PayableEntry[]

  @@index([currentHolderPersonId])
  @@index([status, effectiveAt])
  @@map("qualification")
  @@schema("membership")
}

model MemberNotification {
  sourceEventId String? @unique @map("source_event_id") @db.Uuid
  reads MemberNotificationRead[]
  notificationId String @id @default(uuid()) @map("notification_id") @db.Uuid
  personId String @map("person_id") @db.Uuid
  qualificationId String? @map("qualification_id") @db.Uuid
  category String
  title String
  body String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  person Person @relation(fields: [personId], references: [personId])
  qualification Qualification? @relation(fields: [qualificationId], references: [qualificationId])
  @@unique([notificationId,personId])
  @@index([personId, qualificationId, createdAt])
  @@map("member_notification")
  @@schema("integration")
}

model MemberNotificationRead {
 notificationId String @map("notification_id") @db.Uuid
 personId String @map("person_id") @db.Uuid
 readAt DateTime @default(now()) @map("read_at") @db.Timestamptz(6)
 notification MemberNotification @relation(fields:[notificationId,personId],references:[notificationId,personId])
 @@id([notificationId,personId])
 @@map("member_notification_read")
 @@schema("integration")
}

model QualificationHolderHistory {
  holderHistoryId String   @id @default(uuid()) @map("holder_history_id") @db.Uuid
  qualificationId String   @map("qualification_id") @db.Uuid
  holderPersonId  String   @map("holder_person_id") @db.Uuid
  effectiveFrom   DateTime @map("effective_from") @db.Timestamptz(6)
  effectiveTo     DateTime? @map("effective_to") @db.Timestamptz(6)
  sourceType      String   @map("source_type")
  sourceId        String?  @map("source_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  qualification Qualification @relation(fields: [qualificationId], references: [qualificationId])
  holder Person @relation(fields: [holderPersonId], references: [personId])

  @@index([qualificationId, effectiveFrom])
  @@index([holderPersonId, effectiveFrom])
  @@map("qualification_holder_history")
  @@schema("membership")
}

model SponsorRelationship {
  sponsorRelationshipId String   @id @default(uuid()) @map("sponsor_relationship_id") @db.Uuid
  sponsorQualificationId String  @map("sponsor_qualification_id") @db.Uuid
  childQualificationId   String  @unique @map("child_qualification_id") @db.Uuid
  sponsorSequenceNo      Int     @map("sponsor_sequence_no")
  effectiveFrom          DateTime @map("effective_from") @db.Timestamptz(6)
  effectiveTo            DateTime? @map("effective_to") @db.Timestamptz(6)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sponsor Qualification @relation("Sponsor", fields: [sponsorQualificationId], references: [qualificationId])
  child Qualification @relation("SponsoredChild", fields: [childQualificationId], references: [qualificationId])

  @@unique([sponsorQualificationId, sponsorSequenceNo])
  @@index([sponsorQualificationId, effectiveFrom])
  @@map("sponsor_relationship")
  @@schema("organization")
}

model BinaryPlacement {
  binaryPlacementId      String   @id @default(uuid()) @map("binary_placement_id") @db.Uuid
  parentQualificationId  String   @map("parent_qualification_id") @db.Uuid
  childQualificationId   String   @unique @map("child_qualification_id") @db.Uuid
  side                   SideCode
  effectiveFrom          DateTime @map("effective_from") @db.Timestamptz(6)
  effectiveTo            DateTime? @map("effective_to") @db.Timestamptz(6)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  parent Qualification @relation("BinaryParent", fields: [parentQualificationId], references: [qualificationId])
  child Qualification @relation("BinaryChild", fields: [childQualificationId], references: [qualificationId])

  @@index([parentQualificationId, side, effectiveTo])
  @@map("binary_placement")
  @@schema("organization")
}

model ProductReference {
  productId      String   @id @default(uuid()) @map("product_id") @db.Uuid
  sku            String   @unique
  displayName    String   @map("display_name")
  currentPrice   Decimal  @map("current_price") @db.Decimal(18, 2)
  currency       String   @default("TWD")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  ruleProfiles ProductRuleProfile[]
  orderLines OrderLine[]

  @@map("product_reference")
  @@schema("commerce")
}

model ProductRuleProfile {
  productRuleProfileId String   @id @default(uuid()) @map("product_rule_profile_id") @db.Uuid
  productId            String   @map("product_id") @db.Uuid
  effectiveFrom        DateTime @map("effective_from") @db.Timestamptz(6)
  effectiveTo          DateTime? @map("effective_to") @db.Timestamptz(6)
  gpvRate              Decimal  @default(0.60) @map("gpv_rate") @db.Decimal(10, 6)
  pvRate               Decimal? @map("pv_rate") @db.Decimal(10, 6)
  rpvEligible          Boolean  @default(false) @map("rpv_eligible")
  epvEligible          Boolean  @default(false) @map("epv_eligible")
  ruleVersionCode      String   @map("rule_version_code")
  parameterSnapshotHash String? @map("parameter_snapshot_hash")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product ProductReference @relation(fields: [productId], references: [productId])

  @@index([productId, effectiveFrom, effectiveTo])
  @@map("product_rule_profile")
  @@schema("commerce")
}

model Order {
  orderId           String      @id @default(uuid()) @map("order_id") @db.Uuid
  orderNo           BigInt      @unique @default(autoincrement()) @map("order_no")
  qualificationId   String      @map("qualification_id") @db.Uuid
  purpose           OrderPurpose @default(RETAIL)
  status            OrderStatus @default(DRAFT)
  currency          String      @default("TWD")
  grossAmount       Decimal     @map("gross_amount") @db.Decimal(18, 2)
  discountAmount    Decimal     @default(0) @map("discount_amount") @db.Decimal(18, 2)
  netAmount         Decimal     @map("net_amount") @db.Decimal(18, 2)
  ruleVersionCode   String      @map("rule_version_code")
  parameterSnapshotHash String? @map("parameter_snapshot_hash")
  sourceReferralTokenHash String? @map("source_referral_token_hash")
  clientReference   String?     @map("client_reference")
  confirmedAt       DateTime?   @map("confirmed_at") @db.Timestamptz(6)
  paidAt            DateTime?   @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  qualification Qualification @relation(fields: [qualificationId], references: [qualificationId])
  lines OrderLine[]
  paymentEvents PaymentEvent[]
  returns ReturnCase[]

  @@index([qualificationId, createdAt])
  @@index([status, createdAt])
  @@map("order")
  @@schema("commerce")
}

model OrderLine {
  orderLineId         String   @id @default(uuid()) @map("order_line_id") @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  skuSnapshot         String   @map("sku_snapshot")
  productNameSnapshot String   @map("product_name_snapshot")
  quantity            Decimal  @db.Decimal(18, 4)
  unitPrice            Decimal  @map("unit_price") @db.Decimal(18, 2)
  lineAmount           Decimal  @map("line_amount") @db.Decimal(18, 2)
  gpvRateSnapshot      Decimal  @map("gpv_rate_snapshot") @db.Decimal(10, 6)
  gpvAmountSnapshot    Decimal  @map("gpv_amount_snapshot") @db.Decimal(18, 4)
  pvRateSnapshot       Decimal? @map("pv_rate_snapshot") @db.Decimal(10, 6)
  ruleProfileSnapshot  Json     @map("rule_profile_snapshot")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [orderId])
  product ProductReference @relation(fields: [productId], references: [productId])

  @@index([orderId])
  @@map("order_line")
  @@schema("commerce")
}

model PaymentEvent {
  paymentEventId String   @id @default(uuid()) @map("payment_event_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  eventType      String   @map("event_type")
  amount         Decimal  @db.Decimal(18, 2)
  paymentMethod  String   @map("payment_method")
  referenceNo    String   @map("reference_no")
  idempotencyKey String   @unique @map("idempotency_key")
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(6)
  recordedAt     DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by") @db.Uuid
  correlationId  String   @map("correlation_id") @db.Uuid

  order Order @relation(fields: [orderId], references: [orderId])

  @@index([orderId, occurredAt])
  @@map("payment_event")
  @@schema("commerce")
}

model PvLedger {
  eventId        String   @id @default(uuid()) @map("event_id") @db.Uuid
  qualificationId String  @map("qualification_id") @db.Uuid
  pvType         PvType   @map("pv_type")
  amount         Decimal  @db.Decimal(18, 4)
  sourceType     String   @map("source_type")
  sourceId       String   @map("source_id") @db.Uuid
  sourceLineId   String?  @map("source_line_id") @db.Uuid
  eventType      String   @map("event_type")
  ruleVersionCode String  @map("rule_version_code")
  parameterSnapshotHash String? @map("parameter_snapshot_hash")
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(6)
  recordedAt     DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  reversalOfEventId String? @map("reversal_of_event_id") @db.Uuid
  correlationId  String   @map("correlation_id") @db.Uuid

  qualification Qualification @relation(fields: [qualificationId], references: [qualificationId])

  @@unique([eventType, sourceType, sourceId, sourceLineId, pvType])
  @@index([qualificationId, pvType, occurredAt])
  @@map("pv_ledger")
  @@schema("ledger")
}

model AuditEvent {
  auditEventId  String   @id @default(uuid()) @map("audit_event_id") @db.Uuid
  actorType     String   @map("actor_type")
  actorId       String?  @map("actor_id") @db.Uuid
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id") @db.Uuid
  beforeData    Json?    @map("before_data")
  afterData     Json?    @map("after_data")
  reasonCode    String?  @map("reason_code")
  requestId     String   @map("request_id")
  correlationId String   @map("correlation_id") @db.Uuid
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([entityType, entityId, occurredAt])
  @@index([correlationId])
  @@map("audit_event")
  @@schema("audit")
}

model IdempotencyRecord {
  idempotencyRecordId String   @id @default(uuid()) @map("idempotency_record_id") @db.Uuid
  actorScope          String   @map("actor_scope")
  idempotencyKey      String   @map("idempotency_key")
  requestHash         String   @map("request_hash")
  statusCode          Int?     @map("status_code")
  responseBody        Json?    @map("response_body")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt           DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([actorScope, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_record")
  @@schema("integration")
}

model OutboxEvent {
  outboxEventId   String             @id @default(uuid()) @map("outbox_event_id") @db.Uuid
  eventType       String             @map("event_type")
  aggregateType   String             @map("aggregate_type")
  aggregateId     String             @map("aggregate_id") @db.Uuid
  payload         Json
  processStatus   EventProcessStatus @default(PENDING) @map("process_status")
  attemptCount    Int                @default(0) @map("attempt_count")
  availableAt     DateTime           @default(now()) @map("available_at") @db.Timestamptz(6)
  processedAt     DateTime?          @map("processed_at") @db.Timestamptz(6)
  lastError       String?            @map("last_error")
  correlationId   String             @map("correlation_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([processStatus, availableAt])
  @@map("outbox_event")
  @@schema("integration")
}


model MembershipApplication {
  applicationId             String            @id @default(uuid()) @map("application_id") @db.Uuid
  personId                  String            @map("person_id") @db.Uuid
  requestedPlanLevelCode    String            @map("requested_plan_level_code")
  sponsorQualificationId    String?           @map("sponsor_qualification_id") @db.Uuid
  binaryParentQualificationId String?         @map("binary_parent_qualification_id") @db.Uuid
  binarySide                String?           @map("binary_side")
  status                    ApplicationStatus @default(DRAFT)
  submittedAt               DateTime?         @map("submitted_at") @db.Timestamptz(6)
  approvedAt                DateTime?         @map("approved_at") @db.Timestamptz(6)
  approvedBy                String?           @map("approved_by") @db.Uuid
  effectiveAt               DateTime?         @map("effective_at") @db.Timestamptz(6)
  createdQualificationId    String?           @unique @map("created_qualification_id") @db.Uuid
  sourceReferralTokenHash   String?           @map("source_referral_token_hash")
  note                      String?
  createdAt                 DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

