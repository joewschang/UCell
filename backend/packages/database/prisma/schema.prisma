  @@schema("identity")
}

enum ConsentChannel {
  MEMBER_WEB
  LIFF
  ADMIN_ASSISTED

  @@schema("identity")
}

enum PersonMembershipState {
  NETWORK_MEMBER
  FORMAL_PENDING
  FORMAL_MEMBER

  @@schema("identity")
}

enum OtpPurpose {
  NETWORK_REGISTRATION
  MOBILE_CHANGE
  ACCOUNT_RECOVERY

  @@schema("identity")
}

enum OtpChallengeStatus {
  PENDING
  VERIFIED
  EXPIRED
  LOCKED

  @@schema("identity")
}

enum AuthSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED

  @@schema("identity")
}

model Person {
  qualificationOwnerIntervals QualificationOwnerInterval[]
  personId         String                 @id @default(uuid()) @map("person_id") @db.Uuid
  legalName        String                 @map("legal_name")
  preferredName    String?                @map("preferred_name")
  birthDate        DateTime?              @map("birth_date") @db.Date
  mobile           String?
  email            String?
  genderCode       String?                @map("gender_code")
  membershipState  PersonMembershipState? @map("membership_state")
  mobileVerifiedAt DateTime?              @map("mobile_verified_at") @db.Timestamptz(6)
  status           RecordStatus           @default(DRAFT)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  qualifications           Qualification[]
  holderHistory            QualificationHolderHistory[]
  membershipApplications   MembershipApplication[]
  identityLinks            IdentityLink[]
  authSessions             AuthSession[]
  adminAccessGrants        AdminAccessGrant[]
  memberNotifications      MemberNotification[]
  consentEvidence          ConsentEvidence[]
  membershipStateEvents    PersonMembershipStateEvent[]
  otpChallenges            OtpChallenge[]
  deliveryProfiles         DeliveryProfile[]
  referralAttributions     ReferralAttribution[]
  referralBindingHistory   ReferralAttributionHistory[]
  formalMemberApplications FormalMemberApplication[]

  @@index([legalName])
  @@index([mobile])
  @@map("person")
  @@schema("identity")
}

model FormalMemberApplication {
  formalMemberApplicationId String                            @id @default(uuid()) @map("formal_member_application_id") @db.Uuid
  personId                  String                            @map("person_id") @db.Uuid
  status                    String                            @default("DRAFT")
  currentSnapshotHash       String                            @map("current_snapshot_hash")
  createdAt                 DateTime                          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                          @updatedAt @map("updated_at") @db.Timestamptz(6)
  submittedAt               DateTime?                         @map("submitted_at") @db.Timestamptz(6)
  reviewedAt                DateTime?                         @map("reviewed_at") @db.Timestamptz(6)
  reviewerId                String?                           @map("reviewer_id") @db.Uuid
  decisionReasonCode        String?                           @map("decision_reason_code")
  person                    Person                            @relation(fields: [personId], references: [personId])
  snapshots                 FormalMemberApplicationSnapshot[]

  @@index([personId, status])
  @@map("formal_member_application")
  @@schema("identity")
}

model FormalMemberApplicationSnapshot {
  formalMemberApplicationSnapshotId String                  @id @default(uuid()) @map("formal_member_application_snapshot_id") @db.Uuid
  formalMemberApplicationId         String                  @map("formal_member_application_id") @db.Uuid
  version                           Int
  payloadCiphertext                 String                  @map("payload_ciphertext") @db.Text
  keyVersion                        String                  @map("key_version")
  payloadHash                       String                  @map("payload_hash")
  createdAt                         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  application                       FormalMemberApplication @relation(fields: [formalMemberApplicationId], references: [formalMemberApplicationId])

  @@unique([formalMemberApplicationId, version])
  @@index([payloadHash])
  @@map("formal_member_application_snapshot")
  @@schema("identity")
}

model DeliveryProfile {
  deliveryProfileId String    @id @default(uuid()) @map("delivery_profile_id") @db.Uuid
  personId          String    @map("person_id") @db.Uuid
  recipientName     String    @map("recipient_name")
  contactCiphertext String    @map("contact_ciphertext") @db.Text
  countryCode       String    @map("country_code")
  postalCode        String?   @map("postal_code")
  addressCiphertext String    @map("address_ciphertext") @db.Text
  keyVersion        String    @map("key_version")
  effectiveFrom     DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo       DateTime? @map("effective_to") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  person            Person    @relation(fields: [personId], references: [personId])

  @@index([personId, effectiveFrom, effectiveTo])
  @@map("delivery_profile")
  @@schema("identity")
}

model OtpChallenge {
  otpChallengeId         String             @id @default(uuid()) @map("otp_challenge_id") @db.Uuid
  personId               String?            @map("person_id") @db.Uuid
  registrationSessionId  String?            @map("registration_session_id") @db.Uuid
  purpose                OtpPurpose
  destinationFingerprint String             @map("destination_fingerprint")
  codeHash               String             @map("code_hash")
  providerRef            String             @map("provider_ref")
  status                 OtpChallengeStatus @default(PENDING)
  attemptCount           Int                @default(0) @map("attempt_count")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt              DateTime           @map("expires_at") @db.Timestamptz(6)
  resendAvailableAt      DateTime           @map("resend_available_at") @db.Timestamptz(6)
  verifiedAt             DateTime?          @map("verified_at") @db.Timestamptz(6)
  lockedAt               DateTime?          @map("locked_at") @db.Timestamptz(6)
  consumedAt             DateTime?          @map("consumed_at") @db.Timestamptz(6)
  consumedByPersonId     String?            @map("consumed_by_person_id") @db.Uuid
  correlationId          String             @map("correlation_id") @db.Uuid
  person                 Person?            @relation(fields: [personId], references: [personId])

  @@index([destinationFingerprint, createdAt])
  @@index([registrationSessionId, purpose, status])
  @@index([personId, purpose, status])
  @@map("otp_challenge")
  @@schema("identity")
}

model PersonMembershipStateEvent {
  personMembershipStateEventId String                 @id @default(uuid()) @map("person_membership_state_event_id") @db.Uuid
  personId                     String                 @map("person_id") @db.Uuid
  fromState                    PersonMembershipState? @map("from_state")
  toState                      PersonMembershipState  @map("to_state")
  reasonCode                   String                 @map("reason_code")
  sourceType                   String                 @map("source_type")
  sourceId                     String?                @map("source_id") @db.Uuid
  correlationId                String                 @map("correlation_id") @db.Uuid
  occurredAt                   DateTime               @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt                    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  person                       Person                 @relation(fields: [personId], references: [personId])

  @@index([personId, occurredAt])
  @@index([correlationId])
  @@map("person_membership_state_event")
  @@schema("identity")
}

model ContractDocumentVersion {
  contractDocumentVersionId String            @id @default(uuid()) @map("contract_document_version_id") @db.Uuid
  contractType              String            @map("contract_type")
  versionCode               String            @map("version_code")
  title                     String
  contentText               String            @map("content_text") @db.Text
  contentHash               String            @map("content_hash")
  audience                  ContractAudience
  required                  Boolean           @default(true)
  effectiveFrom             DateTime          @map("effective_from") @db.Timestamptz(6)
  effectiveTo               DateTime?         @map("effective_to") @db.Timestamptz(6)
  approvalReference         String            @map("approval_reference")
  createdAt                 DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  consentEvidence           ConsentEvidence[]

  @@unique([contractType, versionCode])
  @@index([audience, effectiveFrom, effectiveTo])
  @@map("contract_document_version")
  @@schema("identity")
}

model ConsentEvidence {
  consentEvidenceId         String                  @id @default(uuid()) @map("consent_evidence_id") @db.Uuid
  personId                  String                  @map("person_id") @db.Uuid
  contractDocumentVersionId String                  @map("contract_document_version_id") @db.Uuid
  contentHashSnapshot       String                  @map("content_hash_snapshot")
  channel                   ConsentChannel
  acceptedAt                DateTime                @default(now()) @map("accepted_at") @db.Timestamptz(6)
  requestId                 String                  @map("request_id")
  correlationId             String                  @map("correlation_id") @db.Uuid
  evidenceHash              String                  @map("evidence_hash")
  createdAt                 DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  person                    Person                  @relation(fields: [personId], references: [personId])
  contractVersion           ContractDocumentVersion @relation(fields: [contractDocumentVersionId], references: [contractDocumentVersionId])

  @@unique([personId, contractDocumentVersionId])
  @@index([contractDocumentVersionId, acceptedAt])
  @@index([correlationId])
  @@map("consent_evidence")
  @@schema("identity")
}

model Qualification {
 economicDestinations AwardEconomicDestination[]
 companyProfileBindings CompanyBootstrapProfileBinding[]
  kind QualificationKind @default(MEMBER_ORIGIN)
  currentCompanyPrincipalId String? @map("current_company_principal_id") @db.Uuid
  currentCompanyPrincipal CompanyPrincipal? @relation(fields: [currentCompanyPrincipalId], references: [companyPrincipalId])
  ownerIntervals QualificationOwnerInterval[]
  binaryTreeMembership BinaryTreeMembership?
  canonicalPosition TreeCanonicalPosition?
  foundingOccupation FoundingOccupationEvidence?
  treePlacementEvidence PlacementTreeEvidence?
  companySponsorDesignation CompanySponsorDesignation?
  memberNotifications   MemberNotification[]
  qualificationId       String               @id @default(uuid()) @map("qualification_id") @db.Uuid
  qualificationNo       BigInt               @unique @default(autoincrement()) @map("qualification_no")
  currentHolderPersonId String?              @map("current_holder_person_id") @db.Uuid
  planLevelCode         String?              @map("plan_level_code")
  status                RecordStatus         @default(DRAFT)
  activeFlag            Boolean              @default(false) @map("active_flag")
  effectiveAt           DateTime?            @map("effective_at") @db.Timestamptz(6)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  currentHolder               Person?                          @relation(fields: [currentHolderPersonId], references: [personId], onDelete: Restrict)
  holderHistory               QualificationHolderHistory[]
  sponsoredChildren           SponsorRelationship[]            @relation("Sponsor")
  sponsorRelation             SponsorRelationship?             @relation("SponsoredChild")
  binaryChildren              BinaryPlacement[]                @relation("BinaryParent")
  binaryPlacement             BinaryPlacement?                 @relation("BinaryChild")
  orders                      Order[]
  pvEvents                    PvLedger[]
  activePeriods               ActivePeriod[]
  subscriptions               Subscription[]
  membershipApplications      MembershipApplication[]
  bonusAwards                 BonusAward[]                     @relation("BonusRecipient")
  sourceBonusAwards           BonusAward[]                     @relation("BonusSource")
  binaryCarry                 BinaryCarry[]
  qualificationStatusHistory  QualificationStatusHistory[]
  referralLinks               ReferralLink[]
  referralAttributions        ReferralAttribution[]
  systemAssignmentPoolEntries SystemAssignmentPoolEntry[]
  systemAssignmentRoots       SystemAssignmentEvidence[]       @relation("SystemAssignmentRoot")
  systemAssignmentParents     SystemAssignmentEvidence[]       @relation("SystemAssignmentParent")
  systemAssignmentChildren    SystemAssignmentEvidence[]       @relation("SystemAssignmentChild")
  globalRankHistory           QualificationGlobalRankHistory[]
  payoutLines                 PayoutLine[]
  payableEntries              PayableEntry[]

  @@index([currentHolderPersonId])
  @@index([status, effectiveAt])
  @@map("qualification")
  @@schema("membership")
}

model ReferralLink {
  referralLinkId          String                @id @default(uuid()) @map("referral_link_id") @db.Uuid
  tokenHash               String                @unique @map("token_hash")
  referrerQualificationId String                @map("referrer_qualification_id") @db.Uuid
  policyVersion           String                @map("policy_version")
  status                  String                @default("ACTIVE")
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt               DateTime              @map("expires_at") @db.Timestamptz(6)
  referrerQualification   Qualification         @relation(fields: [referrerQualificationId], references: [qualificationId])
  attributions            ReferralAttribution[]

  @@index([referrerQualificationId, createdAt])
  @@map("referral_link")
  @@schema("identity")
}

model ReferralAttribution {
  referralAttributionId   String                       @id @default(uuid()) @map("referral_attribution_id") @db.Uuid
  anonymousId             String                       @map("anonymous_id") @db.Uuid
  personId                String?                      @map("person_id") @db.Uuid
  referrerQualificationId String                       @map("referrer_qualification_id") @db.Uuid
  referralLinkId          String                       @map("referral_link_id") @db.Uuid
  firstTouchAt            DateTime                     @map("first_touch_at") @db.Timestamptz(6)
  lastTouchAt             DateTime                     @map("last_touch_at") @db.Timestamptz(6)
  lockedUntil             DateTime                     @map("locked_until") @db.Timestamptz(6)
  status                  String                       @default("ACTIVE")
  version                 Int                          @default(1)
  createdAt               DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  referrerQualification   Qualification                @relation(fields: [referrerQualificationId], references: [qualificationId])
  referralLink            ReferralLink                 @relation(fields: [referralLinkId], references: [referralLinkId])
  person                  Person?                      @relation(fields: [personId], references: [personId])
  history                 ReferralAttributionHistory[]

  @@unique([anonymousId])
  @@index([personId, status])
  @@index([referrerQualificationId, status])
  @@map("referral_attribution")
  @@schema("identity")
}

model ReferralAttributionHistory {
  referralAttributionHistoryId    String              @id @default(uuid()) @map("referral_attribution_history_id") @db.Uuid
  referralAttributionId           String              @map("referral_attribution_id") @db.Uuid
  action                          String
  previousReferrerQualificationId String?             @map("previous_referrer_qualification_id") @db.Uuid
  newReferrerQualificationId      String?             @map("new_referrer_qualification_id") @db.Uuid
  reasonCode                      String              @map("reason_code")
  referralLinkId                  String?             @map("referral_link_id") @db.Uuid
  correlationId                   String              @map("correlation_id") @db.Uuid
  boundPersonId                   String?             @map("bound_person_id") @db.Uuid
  occurredAt                      DateTime            @default(now()) @map("occurred_at") @db.Timestamptz(6)
  attribution                     ReferralAttribution @relation(fields: [referralAttributionId], references: [referralAttributionId])
  boundPerson                     Person?             @relation(fields: [boundPersonId], references: [personId])

  @@index([referralAttributionId, occurredAt])
  @@index([boundPersonId, occurredAt])
  @@map("referral_attribution_history")
  @@schema("identity")
}

model SystemAssignmentPolicy {
  systemAssignmentPolicyId String                      @id @default(uuid()) @map("system_assignment_policy_id") @db.Uuid
  version                  String                      @unique
  effectiveFrom            DateTime                    @map("effective_from") @db.Timestamptz(6)
  effectiveTo              DateTime?                   @map("effective_to") @db.Timestamptz(6)
  poolSelector             String                      @map("pool_selector")
  tieBreakStrategy         String                      @map("tie_break_strategy")
  capacityPolicy           String                      @map("capacity_policy")
  exclusionPolicy          String                      @map("exclusion_policy")
  lockStrategy             String                      @map("lock_strategy")
  configHash               String                      @map("config_hash")
  approvalReference        String                      @map("approval_reference")
  status                   String                      @default("ACTIVE")
  createdAt                DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  poolEntries              SystemAssignmentPoolEntry[]
  evidence                 SystemAssignmentEvidence[]

  @@index([status, effectiveFrom, effectiveTo])
  @@map("system_assignment_policy")
  @@schema("rules")
}

model SystemAssignmentPoolEntry {
  systemAssignmentPoolEntryId String                 @id @default(uuid()) @map("system_assignment_pool_entry_id") @db.Uuid
  systemAssignmentPolicyId    String                 @map("system_assignment_policy_id") @db.Uuid
  qualificationId             String                 @map("qualification_id") @db.Uuid
  priorityClass               Int                    @map("priority_class")
  capacityLimit               Int?                   @map("capacity_limit")
  eligibilityState            String                 @map("eligibility_state")
  enabledFrom                 DateTime               @map("enabled_from") @db.Timestamptz(6)
  enabledTo                   DateTime?              @map("enabled_to") @db.Timestamptz(6)
  approvalReference           String                 @map("approval_reference")
  createdAt                   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  policy                      SystemAssignmentPolicy @relation(fields: [systemAssignmentPolicyId], references: [systemAssignmentPolicyId])
  qualification               Qualification          @relation(fields: [qualificationId], references: [qualificationId])

  @@unique([systemAssignmentPolicyId, qualificationId])
  @@index([eligibilityState, enabledFrom, enabledTo])
  @@map("system_assignment_pool_entry")
  @@schema("rules")
}

model SystemAssignmentEvidence {
  systemAssignmentEvidenceId  String                 @id @default(uuid()) @map("system_assignment_evidence_id") @db.Uuid
  systemAssignmentPolicyId    String                 @map("system_assignment_policy_id") @db.Uuid
