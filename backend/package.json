{
  "name": "ucell-platform",
  "private": true,
  "version": "0.6.10",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12.4.1 <13"
  },
  "devDependencies": {
    "@prisma/client": "6.19.3",
    "@types/node": "^24.0.0",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "pnpm --filter @ucell/api start:dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test && pnpm test:todo:gate",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @ucell/database prisma generate",
    "db:migrate": "pnpm --filter @ucell/database prisma migrate dev",
    "db:deploy": "pnpm --filter @ucell/database prisma migrate deploy",
    "stage:uat:seed": "node scripts/stage-uat-seed.mjs",
    "stage:uat:seed:test": "node scripts/stage-uat-seed.test.mjs",
    "openapi": "pnpm --filter @ucell/api openapi:export",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "static:validate": "node scripts/static-validate.mjs",
    "convergence:validate": "node scripts/convergence-validate.mjs",
    "golden:domain": "node scripts/golden-domain-test.mjs",
    "preflight": "node scripts/run-bash-gate.mjs ci-gate.sh",
    "schema:preflight": "node scripts/schema-preflight.mjs",
    "migration:preflight": "node scripts/migration-preflight.mjs",
    "source:preflight": "node scripts/source-preflight.mjs",
    "golden:r1b": "node scripts/golden-r1b-regression.mjs",
    "golden:v3:mandatory": "node scripts/v3-mandatory-golden.mjs",
    "dev:smoke": "node scripts/run-bash-gate.mjs dev-smoke.sh",
    "db:golden": "node scripts/db-golden-isolated.mjs",
    "openapi:preflight": "node scripts/openapi-preflight.mjs",
    "http:smoke": "node scripts/http-smoke.mjs",
    "rc:gate": "node scripts/run-bash-gate.mjs rc-gate.sh",
    "prisma:relations:preflight": "node scripts/prisma-relation-preflight.mjs",
    "prisma:access:preflight": "node scripts/prisma-client-access-preflight.mjs",
    "runtime:safety:preflight": "node scripts/runtime-safety-preflight.mjs",
    "enum:migration:preflight": "node scripts/enum-migration-preflight.mjs",
    "golden:economic": "node scripts/golden-economic-cases.mjs",
    "security:preflight": "node scripts/security-policy-preflight.mjs",
    "security:e2e": "node scripts/security-http-e2e.mjs",
    "uat:gate": "node scripts/uat-gate.mjs",
    "release:readiness": "node scripts/release-readiness-preflight.mjs",
    "release:prep": "node scripts/run-bash-gate.mjs release-prep.sh",
    "test:todo:gate": "node scripts/test-todo-gate.mjs",
    "test:api:isolated": "node scripts/api-jest-isolated.mjs",
    "test:member:binary:settlement": "node scripts/member-binary-settlement-db-test.mjs",
    "test:uat:evidence": "node scripts/uat-evidence-db-test.mjs",
    "test:shipment:persistence:isolated": "node scripts/shipment-persistence-db-isolated.mjs"
  }
}
