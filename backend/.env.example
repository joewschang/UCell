NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://ucell:ucell_dev@localhost:5432/ucell?schema=public
SWAGGER_ENABLED=true
JWT_ISSUER=ucell
JWT_AUDIENCE=ucell-api
JWT_ACCESS_SECRET=change-me
LOG_LEVEL=info
APP_BASE_URL=http://localhost:3000

# DEV only. Never true in production.
ADMIN_AUTH_BYPASS=false

ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_ALLOWED_CLOCK_SKEW_SECONDS=30
ADMIN_SESSION_TTL_SECONDS=3600

# LINE Login channel ID used by the backend ID-token verifier. Leave empty only
# in LOCAL/CONNECTED_DEV when formal LINE authentication is intentionally blocked.
LINE_LOGIN_CHANNEL_ID=

# Explicit inventory allocation configuration. Required before the worker can
# reserve stock for a verified PAID transition; no default warehouse is inferred.
UCELL_INVENTORY_WAREHOUSE_ID=
UCELL_INVENTORY_POLICY_VERSION=

# Provider webhook consumer remains disabled until at least one exact
# domain/provider/connection handler has an approved contract and is registered.
UCELL_PROVIDER_WORKER_ENABLED=false
UCELL_PROVIDER_WORKER_LEASE_OWNER=
UCELL_PROVIDER_WORKER_LEASE_MS=120000
UCELL_PROVIDER_WORKER_BATCH_SIZE=20
UCELL_PROVIDER_WORKER_MAX_ATTEMPTS=3
UCELL_PROVIDER_WORKER_RETRY_BACKOFF_SECONDS=30,120
